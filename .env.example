# Application
APP_NAME=LogPulse
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://logpulse:logpulse@localhost:5432/logpulse_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Bootstrap admin account (created/promoted on startup; leave ADMIN_PASSWORD empty to disable)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@logpulse.local
ADMIN_PASSWORD=

# OpenAI / LLM
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Webhook (optional)
WEBHOOK_SECRET=your-webhook-secret
